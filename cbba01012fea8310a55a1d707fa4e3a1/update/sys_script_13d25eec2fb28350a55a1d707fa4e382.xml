        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    if (current.department_code.nil()) {
        return;
    }

    var gr = new GlideRecord('x_2130921_caresy_0_department');
    gr.addQuery('department_code', current.department_code.toString());

    if (!current.isNewRecord()) {
        gr.addQuery('sys_id', '!=', current.sys_id);
    }

    gr.query();

    if (gr.next()) {
        gs.addErrorMessage('Department Code must be unique. This Department Code is already being used.');
        current.setAbortAction(true);
    }

})(current, previous);]]></script>
