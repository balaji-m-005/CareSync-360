        <script><![CDATA[(function executeRule(current, previous /* null when async */) {

    var severity = current.getValue('severity');
    var recommendation = current.getValue('recommendation');

    /*
     * High and Critical insights require a recommendation.
     */
    if ((severity == 'High' || severity == 'Critical') &&
        gs.nil(recommendation)) {

        gs.addErrorMessage(
            'Recommendation is required for High and Critical AI Insights.'
        );

        current.setAbortAction(true);
        return;
    }

})(current, previous);]]></script>
