        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Discharged admission must have a discharge date
    if (current.admission_status == 'Discharged' && current.discharge_date.nil()) {
        gs.addErrorMessage('Discharge Date is required when Admission Status is Discharged.');
        current.setAbortAction(true);
        return;
    }

    // Non-discharged admissions should not have a discharge date
    if (current.admission_status != 'Discharged' && !current.discharge_date.nil()) {
        gs.addErrorMessage('Discharge Date must be empty unless Admission Status is Discharged.');
        current.setAbortAction(true);
        return;
    }

})(current, previous);]]></script>
