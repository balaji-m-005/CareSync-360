        <script><![CDATA[(function executeRule(current, previous /* null when async */) {

    // Nothing to validate if Event Date is empty.
    // Dictionary-level mandatory validation handles empty values.
    if (current.event_date.nil())
        return;

    var eventDateTime = new GlideDateTime(current.event_date);
    var nowDateTime = new GlideDateTime();

    // Event Date cannot be later than the current server date/time.
    if (eventDateTime.getNumericValue() > nowDateTime.getNumericValue()) {

        gs.addErrorMessage(
            'Patient Timeline: Event Date cannot be in the future. ' +
            'Enter a date/time that is now or earlier.'
        );

        current.setAbortAction(true);
    }

})(current, previous);]]></script>
