        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var status = current.patient_status.toString();

    // Only check when the patient is being changed to Inactive or Deceased
    if (status == 'Inactive' || status == 'Deceased') {

        var admissionGR = new GlideRecord('x_2130921_caresy_0_admission');
        admissionGR.addQuery('patient', current.getUniqueValue());
        admissionGR.addQuery('active', true);
        admissionGR.setLimit(1);
        admissionGR.query();

        if (admissionGR.next()) {

            gs.addErrorMessage(
                'This patient cannot be set to Inactive or Deceased because an active admission exists.'
            );

            current.setAbortAction(true);
        }
    }

})(current, previous);]]></script>
