        <script><![CDATA[(function executeRule(current, previous) {

    var status = current.getValue('notification_status');
    var errorMessage = current.getValue('error_message');
    var sentDate = current.getValue('sent_date');

    if (status == 'Sent') {

        // Sent notification must have a sent date.
        if (gs.nil(sentDate)) {
            gs.addErrorMessage(
                'A Sent notification must have a Sent Date.'
            );

            current.setAbortAction(true);
            return;
        }

        // Sent notification cannot contain an error message.
        if (!gs.nil(errorMessage)) {
            gs.addErrorMessage(
                'A Sent notification cannot contain an Error Message.'
            );

            current.setAbortAction(true);
            return;
        }
    }

})(current, previous);]]></script>
