        <script><![CDATA[(function executeRule(current, previous /* null when async */) {

    var status = current.status.toString();

    var terminalStatuses = {
        'Success': true,
        'Failed': true,
        'Partial': true,
        'Cancelled': true
    };

    if (status == 'Started' && !current.completed_at.nil()) {

        gs.addErrorMessage(
            'Completed At must be empty while the integration status is Started.'
        );

        current.setAbortAction(true);
        return;
    }

    if (terminalStatuses[status] && current.completed_at.nil()) {

        gs.addErrorMessage(
            'Completed At is required when the integration status is ' +
            status + '.'
        );

        current.setAbortAction(true);
    }

})(current, previous);]]></script>
