        <script><![CDATA[(function executeRule(current, previous) {

    // No Completion Date means BR-MILE-03 handles
    // the requirement when status is Completed.
    if (current.getValue('completion_date') == '') {
        return;
    }

    // This validation applies specifically to Completed milestones.
    if (current.getValue('milestone_status') != 'Completed') {
        return;
    }

    // Completion Date is a DATE field.
    var completionDate = current.getValue('completion_date');

    var now = new GlideDateTime();
    var today = now.getLocalDate().getValue();

    if (completionDate > today) {

        gs.addErrorMessage(
            'Completion Date cannot be in the future for a Completed milestone.'
        );

        current.setAbortAction(true);
        return;
    }

})(current, previous);]]></script>
