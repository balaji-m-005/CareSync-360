        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    if (!current.active || current.active.toString() !== 'true') {
        return;
    }

    if (!current.patient) {
        return;
    }

    var gr = new GlideRecord('x_2130921_caresy_0_admission');
    gr.addQuery('patient', current.patient);
    gr.addQuery('active', true);
    gr.addQuery('sys_id', '!=', current.sys_id);
    gr.setLimit(1);
    gr.query();

    if (gr.next()) {
        gs.addErrorMessage('This patient already has an active admission. Please close the existing admission before creating another active admission.');
        current.setAbortAction(true);
    }

})(current, previous);]]></script>
