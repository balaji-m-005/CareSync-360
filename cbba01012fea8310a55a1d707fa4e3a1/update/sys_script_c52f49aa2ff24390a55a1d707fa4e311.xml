        <script><![CDATA[(function executeRule(current, previous) {

    // Start Date must be today or a future date.
    // Past dates are not allowed.

    var startDate = current.getValue('start_date');

    // Safety check: Start Date is mandatory
    if (!startDate) {
        gs.addErrorMessage('Start Date is required.');
        current.setAbortAction(true);
        return;
    }

    // Get today's date in YYYY-MM-DD format
    var today = new GlideDateTime();
    var todayDate = today.getDate();

    // Compare the Date field value with today's date.
    // Both values are YYYY-MM-DD.
    if (startDate < todayDate) {

        gs.addErrorMessage(
            'Start Date cannot be in the past. Please enter today or a future date.'
        );

        current.setAbortAction(true);
        return;
    }

})(current, previous);]]></script>
