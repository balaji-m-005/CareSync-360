        <script><![CDATA[(function executeRule(current, previous) {

    // Target Date is mandatory on the form,
    // but keep this check safe for server-side execution.
    if (current.getValue('target_date') == '') {
        return;
    }

    // Target Date is a DATE field, so compare DATE values only.
    var targetDate = current.getValue('target_date');

    var now = new GlideDateTime();
    var today = now.getLocalDate().getValue();

    if (targetDate < today) {

        gs.addErrorMessage(
            'Target Date cannot be in the past. Please select today or a future date.'
        );

        current.setAbortAction(true);
        return;
    }

})(current, previous);]]></script>
