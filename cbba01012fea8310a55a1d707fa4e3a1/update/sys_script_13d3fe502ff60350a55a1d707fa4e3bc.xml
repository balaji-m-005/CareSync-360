        <script><![CDATA[(function executeRule(current, previous /* null when async */) {

    if (!current.ward || !current.bed) {
        return;
    }

    var bedGR = new GlideRecord('x_2130921_caresy_0_bed');

    if (!bedGR.get(current.bed)) {
        gs.addErrorMessage('The selected bed could not be found.');
        current.setAbortAction(true);
        return;
    }

    if (bedGR.ward.toString() !== current.ward.toString()) {
        gs.addErrorMessage('The selected bed does not belong to the selected ward. Please select a bed from the selected ward.');
        current.setAbortAction(true);
    }

})(current, previous);]]></script>
