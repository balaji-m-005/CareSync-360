        <script><![CDATA[(function executeRule(current, previous) {

    // BR-MED-01
    // Active Medication Requires Patient, Admission and Care Plan

    if (current.active == true) {

        var missingReferences = [];

        if (gs.nil(current.patient)) {
            missingReferences.push('Patient');
        }

        if (gs.nil(current.admission)) {
            missingReferences.push('Admission');
        }

        if (gs.nil(current.care_plan)) {
            missingReferences.push('Care Plan');
        }

        if (missingReferences.length > 0) {

            gs.addErrorMessage(
                'Active Medication requires the following reference(s): ' +
                missingReferences.join(', ') + '.'
            );

            current.setAbortAction(true);
        }
    }

})(current, previous);]]></script>
